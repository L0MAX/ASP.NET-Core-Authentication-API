# Copy to .env before running docker compose:
#   cp .env.docker.example .env
#
# Required — used by both SQL Server and the API connection string
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Required — JWT signing key (minimum 32 characters)
JWT_SECRET=YourSuperSecretJwtKeyAtLeast32CharactersLong!!

# Required — HMAC secret for refresh/email/reset token hashing (separate from JWT)
TOKEN_HASH_SECRET=YourTokenHashSecretAtLeast32CharactersLong!!

# Optional overrides
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
SQLSERVER_PORT=1433

# JWT
JwtSettings__Issuer=CleanArchitecture.Api
JwtSettings__Audience=CleanArchitecture.Client
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationInDays=7

# Email verification & password reset
EmailVerificationSettings__TokenExpirationHours=24
PasswordResetSettings__TokenExpirationHours=1
PasswordResetSettings__ResetLinkBaseUrl=http://localhost:8080/reset-password
