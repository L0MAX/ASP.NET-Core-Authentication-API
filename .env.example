# Copy to .env and fill in your values:
#   cp .env.example .env

ASPNETCORE_ENVIRONMENT=Development

# SQL Server
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CleanArchitectureDb;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT (secret must be at least 32 characters)
JwtSettings__Secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARACTERS
JwtSettings__Issuer=CleanArchitecture.Api
JwtSettings__Audience=CleanArchitecture.Client
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationInDays=7

EmailVerificationSettings__TokenExpirationHours=24
